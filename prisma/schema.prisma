// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum Role {
  SUPERADMIN
  OWNER
  STAFF
}

enum OrderStatus {
  QUEUED
  WASHING
  DRYING
  IRONING
  READY
  TAKEN
}

enum PaymentStatus {
  UNPAID
  PENDING
  SETTLEMENT
  FAILURE
}

enum PaymentMethod {
  CASH           // Pembayaran tunai langsung
  TRANSFER       // Transfer bank manual (upload bukti)
  MIDTRANS       // Payment Gateway: Midtrans
  XENDIT         // Payment Gateway: Xendit
  // Gateway lain dapat ditambahkan di masa depan tanpa mengubah struktur
}

enum TransType {
  SUBSCRIPTION
  LAUNDRY_ORDER
}

enum OtpType {
  REGISTER // OTP hanya untuk registrasi, login menggunakan PIN
}

// ============================================
// Models
// ============================================

// ============================================
// Models
// ============================================

model User {
  id                  String   @id @default(uuid())
  phone               String   @unique // Nomor WhatsApp (format: 6281234567890)
  name                String
  pin                 String   // Hashed PIN (4-6 digit, menggunakan bcrypt)
  role                Role     @default(OWNER)
  outletId            String?
  outlet              Outlet?  @relation(fields: [outletId], references: [id])
  // Multi-outlet OWNER (foundation): outletId tetap dipakai sebagai "outlet aktif" pada session,
  // sedangkan kepemilikan outlet dimodelkan via Outlet.ownerId.
  ownedOutlets         Outlet[] @relation("OutletOwner")
  orderStatusChanges   OrderStatusHistory[] @relation("OrderStatusHistoryChangedBy")
  
  // Subscription fields (Owner-level)
  packageId             String?   // Reference to SubscriptionPackage
  package               SubscriptionPackage? @relation(fields: [packageId], references: [id])
  subscriptionExpiresAt DateTime? // Null = no active paid subscription
  subscriptionStartedAt DateTime? // When current subscription period started
  
  isActive            Boolean  @default(true)
  isPinSet            Boolean  @default(false) // Flag untuk cek apakah PIN sudah di-set (setelah register)
  failedLoginAttempts Int      @default(0) // Jumlah percobaan login yang gagal
  lockedUntil         DateTime? // Timestamp sampai kapan akun terkunci (null jika tidak terkunci)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lastLoginAt         DateTime?
  pinChangedAt        DateTime? // Timestamp terakhir PIN diubah

  @@index([outletId])
  @@index([phone])
  @@index([packageId])

  transactions Transaction[] // History pembayaran langganan
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String   // Nomor WhatsApp
  code      String   // Kode OTP (6 digit)
  type      OtpType  // REGISTER (hanya untuk registrasi pemilik toko)
  expiresAt DateTime // Expiry time (5 menit)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([phone, code, isUsed])
  @@index([expiresAt])
}

// ============================================
// Subscription Package Model
// ============================================

model SubscriptionPackage {
  id          String   @id @default(uuid())
  name        String   // "Paket Bersih", "Paket Wangi", "Paket Licin"
  slug        String   @unique // "bersih", "wangi", "licin"
  price       Float    // Monthly price in IDR (49000, 99000, 149000)
  description String?  // Package description
  features    Json     // Array of feature strings
  maxStaff    Int      @default(3) // Maximum staff members (-1 = unlimited)
  maxOutlets  Int      @default(1) // Maximum outlets allowed (NEW)
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0) // Display order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
  
  @@index([slug])
  @@index([isActive])
  @@index([isDefault])
  @@index([sortOrder])

  transactions Transaction[] // History pembelian paket ini
}

model Outlet {
  id            String                @id @default(uuid())
  name          String
  slug          String                @unique // URL: domain.com/outlet/[slug]
  address       String
  // Landing page fields (PUBLIC)
  description   String?
  contactPhone  String?               // Nomor WhatsApp untuk CTA (format: 628xxxx)
  businessHours String?               // Teks jam operasional (bebas)
  seoTitle      String?
  seoDescription String?
  logoUrl       String?
  coverUrl      String?
  isPro         Boolean               @default(false)
  
  // Owner relationship (1 OWNER bisa memiliki banyak outlet)
  ownerId       String?
  owner         User?                 @relation("OutletOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  users         User[]
  services      Service[]
  customers     Customer[]    // Daftar pelanggan outlet
  orders        Order[]
  bankAccounts  BankAccount[]         // Multiple rekening bank untuk transfer pelanggan
  paymentGatewayConfigs PaymentGatewayConfig[] // Konfigurasi payment gateway per outlet
  expenses      Expense[]             // Pengeluaran operasional outlet
  transactions  Transaction[]         // Transaksi terkait outlet

  @@index([ownerId])
}

model BankAccount {
  id          String        @id @default(uuid())
  outletId    String
  outlet      Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  bankName    String        // Nama bank (e.g., "BCA", "Mandiri", "BNI")
  accountName String        // Nama pemilik rekening
  accountNumber String      // Nomor rekening
  isActive    Boolean       @default(true) // Untuk enable/disable rekening tertentu
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  transactions Transaction[] // Transaksi yang menggunakan rekening ini

  @@index([outletId])
}

model Service {
  id          String   @id @default(uuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name        String   // Nama layanan (e.g., "Cuci Kiloan", "Setrika Satuan")
  type        String   // Jenis layanan: "KILOAN", "SATUAN", "PAKET"
  price       Float    // Harga per unit
  unit        String?  // Unit (e.g., "kg", "pcs", "paket")
  description String?  // Deskripsi layanan
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]

  @@index([outletId])
}

model Order {
  id           String        @id @default(uuid())
  trackingCode String        @unique // Kode pendek acak untuk publik
  status       OrderStatus   @default(QUEUED)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod? // Metode pembayaran: CASH, TRANSFER, MIDTRANS, atau XENDIT (null jika belum dibayar)
  paidAt       DateTime?      // Timestamp ketika order ditandai LUNAS (bookkeeping)
  paymentNote  String?        // Catatan internal terkait pembayaran (opsional)
  // DP (uang muka) untuk order laundry (single DP)
  dpAmount     Float         @default(0) // Nominal DP (rupiah, tanpa desimal)
  cashReceived Float         @default(0) // Uang tunai yang diterima (untuk kembalian)
  dpPaidAt     DateTime?      // Timestamp DP dicatat
  dpNote       String?        // Catatan DP (opsional)
  totalAmount  Float
  outletId     String
  outlet       Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)

  customerName String?       // Nama pelanggan (snapshot saat order dibuat)
  customerPhone String?      // Nomor telepon pelanggan (snapshot)
  customerId   String?       // Relasi ke data pelanggan terdaftar (opsional)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notes        String?       // Catatan tambahan
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  completedAt  DateTime?    // Timestamp ketika order selesai (status = TAKEN)
  transactions Transaction[]
  items        OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([outletId])
  @@index([trackingCode])
  @@index([status])
  @@index([paymentStatus])
}

model OrderStatusHistory {
  id              String      @id @default(uuid())
  orderId          String
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus       OrderStatus
  toStatus         OrderStatus
  changedByUserId  String?
  changedByUser    User?       @relation("OrderStatusHistoryChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())

  @@index([orderId])
  @@index([changedByUserId])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  // Snapshot layanan saat order dibuat (untuk invoice/riwayat meski service berubah/hilang)
  serviceName String
  serviceType String
  serviceUnit String?
  quantity    Float
  unitPrice   Float
  subtotal    Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([serviceId])
}

model PaymentGatewayConfig {
  id            String        @id @default(uuid())
  outletId      String
  outlet        Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  gatewayType   PaymentMethod // MIDTRANS atau XENDIT
  isActive      Boolean       @default(false) // Enable/disable gateway tertentu
  apiKey        String        // Encrypted API key untuk gateway
  secretKey     String?       // Encrypted secret key (jika diperlukan)
  merchantId    String?       // Merchant ID (jika diperlukan)
  webhookSecret String?       // Secret untuk verifikasi webhook
  config        Json?         // Konfigurasi tambahan dalam format JSON (flexible)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
  
  @@unique([outletId, gatewayType]) // Satu outlet hanya bisa punya satu config per gateway type
  @@index([outletId])
}

model Transaction {
  id           String        @id @default(uuid())
  type         TransType     // Pembeda antara langganan SaaS atau pesanan cucian
  amount       Float
  paymentMethod PaymentMethod? // Metode pembayaran: CASH, TRANSFER, MIDTRANS, XENDIT
  proofUrl     String?       // URL gambar bukti transfer (Cloudinary) - hanya untuk TRANSFER
  status       PaymentStatus @default(PENDING)
  externalId   String?       // ID referensi dari Payment Gateway (transaction_id dari Midtrans/Xendit)
  gatewayTransactionId String? // ID transaksi unik dari gateway (untuk tracking)
  gatewayResponse Json?      // Response lengkap dari gateway (untuk debugging/audit)
  webhookData  Json?         // Data webhook dari gateway (untuk verifikasi)
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  outletId     String?
  outlet       Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  bankAccountId String?      // ID rekening yang digunakan (jika paymentMethod = TRANSFER)
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  paymentGatewayConfigId String? // ID konfigurasi gateway yang digunakan
  paymentGatewayConfig PaymentGatewayConfig? @relation(fields: [paymentGatewayConfigId], references: [id], onDelete: SetNull)
  
  // Subscription Payment Fields (Phase 4)
  userId       String?       // Owner who pays (for Subscription)
  user         User?         @relation(fields: [userId], references: [id])
  packageId    String?       // Package being purchased
  package      SubscriptionPackage? @relation(fields: [packageId], references: [id])

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  settledAt    DateTime?     // Timestamp ketika pembayaran diselesaikan

  @@index([orderId])
  @@index([outletId])
  @@index([status])
  @@index([paymentMethod])
  @@index([gatewayTransactionId])
}

model Customer {
  id          String   @id @default(uuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name        String
  phone       String?  // Nomor WhatsApp/Telepon (opsional, tapi jika ada harus unik per outlet)
  email       String?  // Email (opsional)
  address     String?  // Alamat (opsional)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@unique([outletId, phone]) // Phone unik per outlet (jika tidak null)
  @@index([outletId])
  @@index([name])
  @@index([phone])
}

model Expense {
  id          String   @id @default(uuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  amount      Float    // Menggunakan Float agar konsisten dengan Order.totalAmount
  description String
  category    String?  // e.g. "Operasional", "Gaji", "Bahan Baku"
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([outletId])
  @@index([date])
}
