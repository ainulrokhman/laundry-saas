# ============================================
# Laundry SaaS Platform - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# ============================================
# Database Configuration
# ============================================
# Neon.tech PostgreSQL (Singapore region - ap-southeast-1)
# Use pooled connection for Vercel deployment
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ============================================
# Test Database Configuration (Optional)
# ============================================
# Separate database for testing to avoid affecting development data
# If not set, tests will use DATABASE_URL
# Recommended: Create a separate test database in Neon.tech
TEST_DATABASE_URL="postgresql://user:password@host:5432/test_database?sslmode=require"

# ============================================
# NextAuth.js Configuration
# ============================================
# For local development
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# ============================================
# WhatsApp Service (Fonnte API)
# ============================================
# Get your API key from https://fonnte.com
FONNTE_API_KEY="your-fonnte-api-key"
# Optional: Default is https://api.fonnte.com
FONNTE_API_URL="https://api.fonnte.com"

# ============================================
# Cloudinary Configuration (Optional)
# ============================================
# For storing payment proofs, outlet logos, and images
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ============================================
# Environment
# ============================================
# Set to "production" for production deployment
# Set to "development" for local development
NODE_ENV="development"
